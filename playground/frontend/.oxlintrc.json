{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["typescript", "unicorn", "oxc"],
  "categories": {
    "correctness": "error",
    "suspicious": "error"
  },
  "ignorePatterns": ["dist/**", "node_modules/**", "public/**"],
  "env": {
    "browser": true,
    "es2022": true
  },
  "rules": {
    "no-unused-vars": ["error", { "argsIgnorePattern": "^_" }],
    // Worker.postMessage takes (message, transfer), not Window.postMessage's
    // (message, targetOrigin), this rule conflates the two and its auto-fix
    // would break the call.
    "unicorn/require-post-message-target-origin": "off"
  },
  "overrides": [
    {
      "files": ["src/worker-runtime.ts"],
      "env": { "browser": false, "worker": true }
    }
  ]
}
