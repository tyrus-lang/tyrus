# MongoDB connection string
MONGO_URI=
DB_NAME=
PLAYGROUND_ADMIN_TOKEN=
PORT=

# Tyrus compiler binary path
TYRUS_BIN=tyrus

# Optional WASM compiler paths. Set these for a custom LLVM installation.
TYRUS_WASM_RUNTIME_LIB=
TYRUS_LLC=
TYRUS_WASM_LD=
LD_LIBRARY_PATH=

# Sandbox binary. Without it the backend falls back to ulimit-only isolation,
# which is fine locally and not enough for a public deployment.
NSJAIL_BIN=/usr/bin/nsjail

# Cgroup subtree nsjail may create groups under. The systemd unit sets this and
# grants the delegation (Delegate=yes), so it is normally left empty here, set
# it only when running the backend outside that unit. Startup fails with the
# reason if it is wrong, so it cannot silently disable isolation.
# See "Cgroup delegation" in playground/README.md.
NSJAIL_CGROUP_MOUNT=

# Origin for share links. Defaults to the request's own host.
PLAYGROUND_ORIGIN=
