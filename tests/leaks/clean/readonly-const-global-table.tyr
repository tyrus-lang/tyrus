// The `readonly const` spelling of the same promotion covered by
// `constant-global-table.tyr`.
//
// It is a separate case because the qualifier used to disqualify the
// declaration: `is_constant_array_literal` matched `Type::Array` only, so a
// readonly array (the best candidate there is for read-only memory) was the
// one shape that never reached it, and fell back to a heap buffer. This case
// fails the day that regresses, because the count it produces depends on the
// table being read correctly on every iteration.
readonly const PRIMES: i32[] = [2, 3, 5, 7, 11];
readonly const LABELS: string[] = ["alpha", "beta"];

export function main(): void {
    let sum: i32 = 0;
    for (let i: usize = 0; i < PRIMES.length; i = i + 1) {
        sum = sum + PRIMES[i];
    }
    console.log(sum);
    console.log(LABELS[1]);
}
