// A failing `chown` must release a computed path before its error transfer
// jumps to `catch`.
import { writeFileSync, chown, rm, type RmOptions, type FsError } from "tyrus:fs";

const main = (): void => {
    const dir = "./__fs_chown_computed_path_leak_tmp__";
    const opts: RmOptions = { force: true, recursive: true };
    try {
        rm(dir, opts);
        writeFileSync(`${dir}.txt`, "content");
    } catch (e: FsError) {}

    for (let i: i32 = 0; i < 50; i += 1) {
        try {
            chown(`${dir}.txt`, 0, 0);
        } catch (e: FsError) {}
    }

    try {
        rm(`${dir}.txt`, opts);
    } catch (e: FsError) {}
};
