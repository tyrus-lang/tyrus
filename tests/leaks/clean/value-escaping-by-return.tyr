// A `Map` returned from a function escapes its scope. The callee excludes the
// returned binding from its own cleanup, correctly, the value outlives it,
// and nobody claimed it afterwards, so it leaked 96 bytes per iteration.
//
// The caller now claims it, but only from a callee that provably allocated what
// it returns. A string return is claimed unconditionally because it is copied
// on the way out; a `Map` is a shared handle and is not copied, so claiming
// every one of them frees a container the caller still owns.
//
// The shapes below are all here because the analysis has to answer each one
// correctly, and two of them broke it during development:
//
//   `passthrough`  returns a parameter. Claiming it produced 1400 invalid frees
//                  in a fifty-iteration loop.
//   `conditional`  returns a parameter from a *branch*. An `if` is an
//                  expression here, so it reaches the analysis as a
//                  statement-expression, which was allowed through wholesale,
//                  hiding the nested `return` and making this function look
//                  like it only ever returned a fresh container.
//
// Both are refused now. They are called here with an argument the caller still
// owns and releases itself, so nothing leaks and nothing is freed twice, which
// is exactly what a refusal has to look like from the outside. A callee that is
// refused *and* allocates does leak; that shape stays in `known/`.
//
// Expected output is 250.
const build = (): Map<string, i32> => {
    const scores = Map<string, i32>();
    scores.set("a", 1);
    return scores;
};

const buildSet = (): Set<string> => {
    const seen = Set<string>();
    seen.add("a");
    return seen;
};

const passthrough = (source: Map<string, i32>): Map<string, i32> => {
    return source;
};

const conditional = (flag: boolean, source: Map<string, i32>): Map<string, i32> => {
    if (flag) {
        return source;
    }
    const fresh = Map<string, i32>();
    fresh.set("b", 2);
    return fresh;
};

const main = (): void => {
    let total: usize = 0;
    for (let i: i32 = 0; i < 50; i += 1) {
        total += build().size;

        const owned = build();
        total += owned.size;

        total += passthrough(owned).size;
        total += conditional(true, owned).size;

        total += buildSet().size;
    }
    console.log(total);
    console.log("assert:", 250);
};
