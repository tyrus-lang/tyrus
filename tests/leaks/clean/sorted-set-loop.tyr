// SortedSet insert/contains/remove/min/max/len/isEmpty in a 200-iteration loop,
// with a rebind and an unbound temporary each iteration.
import { SortedSet } from "tyrus:algorithm";

const main = (): void => {
    let total: usize = 0;
    for (let i: i32 = 0; i < 200; i += 1) {
        let s = SortedSet<i32>();
        s.insert(i);
        s.insert(i + 1);
        s.insert(i + 2);
        s.insert(i + 2);
        if (s.contains(i + 1)) {
            total += 1;
        }
        if (s.contains(i + 100)) {
            total += 1;
        }
        total += s.len();
        if (s.isEmpty()) {
            total += 1;
        }
        if ((s.min() ?? 0) >= 0) {
            total += 1;
        }
        if ((s.max() ?? 0) > i + 1) {
            total += 1;
        }
        s.remove(i + 1);
        if (s.contains(i + 1)) {
            total += 1;
        }
        s = SortedSet<i32>();
    }
    console.log(total);
    console.log("assert:", 1200);
};
