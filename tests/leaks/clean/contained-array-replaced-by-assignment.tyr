// Conditionally replacing a stack-contained array used to free a stack
// address, a reproducible SIGSEGV, not a leak.
//
// The escape analysis decides at the *declaration* whether an array's buffer
// lives on the stack. Its walker looked at every expression it could reach,
// but an assignment's target is a name rather than an expression, so nothing
// ever saw `numbers = [...]`: the declaration stayed contained and the literal
// went on the stack, while the assignment allocated a heap buffer and
// registered a release against the binding. On the path where the assignment
// never runs, that release loads the slot, still holding the stack pointer,
// and hands it to `free`.
//
// Found while adding the loop-counter subject the bounds-check analysis needs,
// which reads the same walker. Assigning to the binding now ends the walk for
// every subject: it replaces the value the walk is reasoning about, so the
// declaration is no longer contained and both paths hold heap buffers.
const main = (): void => {
    let total: usize = 0;
    for (let i: i32 = 0; i < 200; i += 1) {
        let numbers: i32[] = [1, 2, 3];
        if (i > 1000) {
            numbers = [4, 5, 6];
        }
        total += numbers.length;
    }
    console.log(total);
};
