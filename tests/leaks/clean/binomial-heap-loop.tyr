// BinomialHeap push/pop/peek/len/isEmpty/clear in a 200-iteration loop,
// with enough pushes per heap to drive meld chains and degree carries.
import { BinomialHeap } from "tyrus:algorithm";

const main = (): void => {
    let total: usize = 0;
    for (let i: i32 = 0; i < 200; i += 1) {
        const bh = BinomialHeap<i32>();
        bh.push(10);
        bh.push(3);
        bh.push(7);
        bh.push(1);
        bh.push(20);
        bh.push(15);
        total += bh.len();
        bh.pop();
        bh.pop();
        bh.pop();
        total += bh.len();
        const top: i32? = bh.peek();
        if (top) { total += 1; }
        bh.clear();
    }
    console.log(total);
    console.log("assert:", 2000);
};
