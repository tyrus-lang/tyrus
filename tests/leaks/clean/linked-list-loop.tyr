// LinkedList pushFront/pushBack/popFront/popBack/front/back/len/isEmpty/clear in a 200-iteration loop.
import { LinkedList } from "tyrus:algorithm";

const main = (): void => {
    let total: usize = 0;
    for (let i: i32 = 0; i < 200; i += 1) {
        const ll = LinkedList<i64>();
        ll.pushBack(10);
        ll.pushFront(20);
        ll.pushBack(30);
        total += ll.len();
        const f: i64? = ll.front();
        if (f) {
            total += 1;
        }
        const b: i64? = ll.back();
        if (b) {
            total += 1;
        }
        const p: i64? = ll.popFront();
        if (p) {
            total += 1;
        }
        total += ll.len();
        ll.clear();
    }
    console.log(total);
    console.log("assert:", 1600);
};
