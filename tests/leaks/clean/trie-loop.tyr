// Trie insert/search/startsWith/len/isEmpty/clear in a 200-iteration loop,
// with a rebind, unbound temporaries, and duplicate inserts each iteration.
import { Trie } from "tyrus:algorithm";

const main = (): void => {
    let total: usize = 0;
    for (let i: i32 = 0; i < 200; i += 1) {
        let t = Trie();
        t.insert("apple");
        t.insert("app");
        t.insert("banana");
        t.insert("apple");
        if (t.search("apple")) {
            total += 1;
        }
        if (t.search("apricot")) {
            total += 1;
        }
        if (t.startsWith("app")) {
            total += 1;
        }
        if (t.startsWith("ban")) {
            total += 1;
        }
        if (t.startsWith("berry")) {
            total += 1;
        }
        total += t.len();
        if (t.isEmpty()) {
            total += 1;
        }
        t.clear();
        if (t.isEmpty()) {
            total += 1;
        }
        if (t.search("apple")) {
            total += 1;
        }
        t = Trie();
    }
    console.log(total);
    console.log("assert:", 1400);
};
