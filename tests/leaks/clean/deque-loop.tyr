// Deque pushFront/pushBack/popFront/popBack/peekFront/peekBack/len/isEmpty/clear in a 200-iteration loop.
import { Deque } from "tyrus:algorithm";

const main = (): void => {
    let total: usize = 0;
    for (let i: i32 = 0; i < 200; i += 1) {
        const dq = Deque<i32>();
        dq.pushBack(10);
        dq.pushBack(20);
        dq.pushBack(30);
        dq.pushFront(5);
        total += dq.len();
        dq.peekFront();
        dq.peekBack();
        dq.popFront();
        dq.popBack();
        total += dq.len();
        dq.clear();
    }
    console.log(total);
    console.log("assert:", 1200);
};
