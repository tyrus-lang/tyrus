// BinaryHeap push/pop/peek/len/isEmpty/clear in a 200-iteration loop.
import { BinaryHeap } from "tyrus:algorithm";

const main = (): void => {
    let total: usize = 0;
    for (let i: i32 = 0; i < 200; i += 1) {
        const bh = BinaryHeap<i32>();
        bh.push(10);
        bh.push(3);
        bh.push(7);
        bh.push(1);
        total += bh.len();
        bh.pop();
        bh.pop();
        bh.pop();
        bh.pop();
        total += bh.len();
    }
    console.log(total);
    console.log("assert:", 800);
};
