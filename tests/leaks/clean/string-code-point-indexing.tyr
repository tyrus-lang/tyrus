// Code point indexing allocates on every call: `charAt` builds a one
// character string, `slice`/`substring` build a fresh range, and padding
// builds the padded copy. Non-ASCII text is what makes the byte offset and
// the code point index differ, so it exercises the conversion path too.
const main = (): void => {
    let total: usize = 0;
    for (let i: i32 = 0; i < 200; i += 1) {
        const accented: string = "héllo";
        const first: string = accented.charAt(1);
        const window: string = accented.slice(1, 3);
        const tail: string = accented.substring(2);
        const padded: string = first.padStart(4, "é");
        const astral: string = "a🚀b".charAt(1);
        total += first.length + window.length + tail.length + padded.length + astral.length;
        total += accented.indexOf("llo") as usize;
    }
    console.log(total);
};
