// Counter add/count/remove/total/unique/isEmpty/clear in a 200-iteration loop.
import { Counter } from "tyrus:algorithm";

const main = (): void => {
    let total: i32 = 0;
    for (let i: i32 = 0; i < 200; i += 1) {
        const c = Counter<i32>();
        c.add(1);
        c.add(2);
        c.add(3);
        c.add(1);
        c.add(2);
        c.add(1);
        total += c.count(1);
        total += c.count(2);
        total += c.total();
        c.remove(1);
        c.clear();
    }
    console.log(total);
    console.log("assert:", 2200);
};
